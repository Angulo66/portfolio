---
// Header component for the portfolio site
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '';
---

<header class="fixed top-0 left-0 w-full z-50 transition-all duration-300 flex justify-center pt-8">
  <!-- Mobile Menu Button (only visible on mobile) -->
  <button
    id="mobile-menu-button"
    class="md:hidden fixed top-4 right-4 text-gray-300 hover:text-white focus:outline-none bg-black bg-opacity-50 backdrop-blur-sm p-2 rounded-full"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <!-- Centered Desktop Navigation -->
  <nav
    class="hidden md:block fixed top-8 bg-black bg-opacity-80 border border-gray-800 backdrop-blur-sm rounded-full px-16 py-3 shadow-lg transition-all duration-300 animate-slide-down"
  >
    <div class="flex items-center gap-8">
      <a href="#home" class="text-gray-300 hover:text-white transition-colors duration-300 relative py-1 group" data-nav-link>
        Start
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-full nav-indicator rounded-full"
        ></span>
      </a>

      <a
        href={isHomePage ? '#about' : '/'}
        class="text-gray-300 hover:text-white transition-colors duration-300 relative py-1 group"
        data-nav-link
      >
        About
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-full nav-indicator rounded-full"
        ></span>
      </a>

      <a
        href={isHomePage ? '#skills' : '/#skills'}
        class="text-gray-300 hover:text-white transition-colors duration-300 relative py-1 group"
        data-nav-link
      >
        Skills
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-full nav-indicator rounded-full"
        ></span>
      </a>

      <a href="#projects" class="text-gray-300 hover:text-white transition-colors duration-300 relative py-1 group" data-nav-link>
        Projects
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-full nav-indicator rounded-full"
        ></span>
      </a>

      <!-- CV/Resume Button with download icon -->
      <a
        href="/resume.pdf"
        target="_blank"
        class="text-gray-300 hover:text-white transition-colors duration-300 relative py-1 group flex items-center"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
        CV
        <span
          class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-full rounded-full"
        ></span>
      </a>
    </div>
  </nav>

  <!-- Mobile Navigation Menu -->
  <div id="mobile-menu" class="hidden md:hidden fixed top-0 left-0 w-full h-full bg-black bg-opacity-90 backdrop-blur-md z-50">
    <div class="absolute top-4 right-4">
      <button id="close-menu-button" class="text-gray-300 hover:text-white focus:outline-none p-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="flex items-center justify-center h-full">
      <ul class="space-y-6 text-center">
        <li>
          <a href="#home" class="block text-2xl text-gray-300 hover:text-white transition-colors duration-300 py-2 relative group">
            Start
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-24 rounded-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href={isHomePage ? '#about' : '/'}
            class="block text-2xl text-gray-300 hover:text-white transition-colors duration-300 py-2 relative group"
          >
            About
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-24 rounded-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href={isHomePage ? '#skills' : '/#skills'}
            class="block text-2xl text-gray-300 hover:text-white transition-colors duration-300 py-2 relative group"
          >
            Skills
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-24 rounded-full"
            ></span>
          </a>
        </li>
        <li>
          <a
            href={isHomePage ? '#projects' : '/#projects'}
            class="block text-2xl text-gray-300 hover:text-white transition-colors duration-300 py-2 relative group"
          >
            Projects
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-24 rounded-full"
            ></span>
          </a>
        </li>

        <!-- CV/Resume Link -->
        <li>
          <a
            href="/resume.pdf"
            target="_blank"
            class="block text-2xl text-gray-300 hover:text-white transition-colors duration-300 py-2 relative group flex items-center justify-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            Download CV
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-pink-500 to-blue-600 transition-all duration-300 group-hover:w-24 rounded-full"
            ></span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  @keyframes slide-down {
    0% {
      transform: translateY(-20px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .animate-slide-down {
    animation: slide-down 0.5s ease forwards;
  }
</style>

<script>
  // Mobile menu toggle functionality and scroll effects
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('nav.hidden.md\\:block');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const closeMenuButton = document.getElementById('close-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll('[data-nav-link]');

    // Mobile menu toggle
    if (mobileMenuButton && mobileMenu && closeMenuButton) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // Prevent scrolling when menu is open
      });

      closeMenuButton.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        document.body.style.overflow = ''; // Re-enable scrolling
      });

      // Close menu when clicking on a link
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = ''; // Re-enable scrolling
        });
      });
    }

    // Update active nav link based on scroll position
    function updateActiveNavLink() {
      const scrollPosition = window.scrollY;

      // Get all sections
      const sections = ['home', 'about', 'skills', 'projects']
        .map((id) => {
          const element = document.getElementById(id);
          return element ? { id, top: element.offsetTop - 100, element } : null;
        })
        .filter((section) => section !== null) as { id: string; top: number; element: HTMLElement }[];

      // Find the current section
      let currentSection: string | null = null;
      for (const section of sections) {
        if (scrollPosition >= section.top) {
          currentSection = section.id;
        } else {
          break;
        }
      }

      // Update nav links
      if (currentSection) {
        navLinks.forEach((link) => {
          const href = link.getAttribute('href');
          const indicator = link.querySelector('.nav-indicator') as HTMLElement | null;

          if (href && href.includes(currentSection as string)) {
            if (indicator) indicator.style.width = '100%';
          } else {
            if (indicator) indicator.style.width = '0';
          }
        });
      }
    }

    // Handle scroll events
    window.addEventListener('scroll', () => {
      // Add background to nav when scrolling
      if (window.scrollY > 50) {
        if (nav) nav.classList.add('shadow-xl');
      } else {
        if (nav) nav.classList.remove('shadow-xl');
      }

      // Update active nav link
      updateActiveNavLink();
    });

    // Initial check for active link
    updateActiveNavLink();

    // Handle hash links smoothly
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
        const targetId = this.getAttribute('href') || '';
        if (targetId === '#') return;

        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({ behavior: 'smooth' });

          // Update URL without page reload
          history.pushState(null, '', targetId);

          // Update active nav link
          setTimeout(updateActiveNavLink, 100);
        }
      });
    });
  });
</script>
