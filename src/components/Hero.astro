<style>
  #home {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding: 16px;
    height: 100vh;
    width: 100%;
    max-width: 1200px;
    position: relative;
    text-align: center;
    scroll-margin-top: 80px;
    overflow: hidden;
  }

  /* Floating elements styles */
  .floating-elements {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .floating-piece {
    position: absolute;
    opacity: 0.6;
  }

  .floating-1 {
    top: 15%;
    left: 10%;
    width: 60px;
    height: 60px;
    animation: float 8s ease-in-out infinite;
  }

  .floating-2 {
    top: 25%;
    right: 15%;
    width: 80px;
    height: 80px;
    animation: float 12s ease-in-out infinite 1s;
  }

  .floating-3 {
    bottom: 20%;
    left: 20%;
    width: 50px;
    height: 50px;
    animation: float 10s ease-in-out infinite 2s;
  }

  .floating-4 {
    top: 60%;
    right: 10%;
    width: 40px;
    height: 40px;
    animation: float 9s ease-in-out infinite 1.5s;
  }

  .floating-5 {
    top: 75%;
    right: 30%;
    width: 35px;
    height: 35px;
    animation: float 11s ease-in-out infinite 0.5s;
  }

  .floating-6 {
    top: 40%;
    left: 5%;
    width: 45px;
    height: 45px;
    animation: float 13s ease-in-out infinite 3s;
  }

  @keyframes float {
    0% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(10deg);
    }
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  /* Add a second animation for some elements */
  .floating-2,
  .floating-4,
  .floating-6 {
    animation-name: float-alt;
  }

  @keyframes float-alt {
    0% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
    33% {
      transform: translateY(-15px) rotate(5deg) scale(1.05);
    }
    66% {
      transform: translateY(10px) rotate(-5deg) scale(0.95);
    }
    100% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
  }

  h1 {
    font-size: 84px;
    margin-top: 0;
    margin-bottom: 0.2em;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  pre {
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    font-weight: normal;
    color: var(--text-secondary);
    margin: 0 0 1.5em 0;
    font-size: 24px;
    letter-spacing: 0.05em;
  }

  p {
    color: var(--text-secondary);
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.006em;
    margin: 0;
    max-width: 700px;
  }

  /* Mobile styles */
  @media screen and (max-width: 768px) {
    #home {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding-bottom: 0;
      height: 100vh;
      min-height: 100vh;
      margin-top: 0; /* Ensure no extra margin pushes content down */
      padding-top: 60px; /* Add padding to account for the fixed header */
    }

    h1 {
      font-size: 56px;
      margin-bottom: 0.2em;
      line-height: 1.1;
    }

    pre {
      font-size: 20px;
    }

    p {
      font-size: 18px;
    }
  }
</style>
