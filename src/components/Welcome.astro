---
import background from '../assets/background.svg';
---

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>
		<section id="home">
			<pre>Fullstack Developer</pre>
			<h1>Helder Lopez</h1>
			<p>Passionate about crafting elegant solutions with modern web technologies</p>

			<div class="quote box">
				<p class="quote-text">"Code is like humor. When you have to explain it, it's bad."</p>
				<p class="quote-author">— Cory House</p>
			</div>

			<div id="links">
				<a href="#about" class="button">About Me</a>
				<a href="#projects">Projects</a>
				<a href="#contact">Contact</a>
			</div>
		</section>

		<section id="about">
			<h2 class="section-title">About Me</h2>
			<div class="about-content box">
				<div class="about-text">
					<p>
						Hello! I'm Helder Lopez, a passionate fullstack developer with expertise in building modern web applications.
						With over 5 years of experience in the industry, I've worked on a variety of projects ranging from
						small business websites to complex enterprise applications.
					</p>
					<p>
						I enjoy solving complex problems and turning ideas into reality through clean, efficient code.
						My approach combines technical expertise with a strong focus on user experience and business needs.
					</p>
				</div>
			</div>
		</section>

		<section id="skills">
			<h2 class="section-title">Skills & Technologies</h2>
			<div class="skills-content box">
				<div class="skill-categories">
					<div class="skill-category">
						<h3>Frontend</h3>
						<div class="skill-tags">
							<span class="skill-tag">JavaScript</span>
							<span class="skill-tag">TypeScript</span>
							<span class="skill-tag">React</span>
							<span class="skill-tag">HTML/CSS</span>
							<span class="skill-tag">Tailwind CSS</span>
							<span class="skill-tag">Responsive Design</span>
						</div>
					</div>

					<div class="skill-category">
						<h3>Backend</h3>
						<div class="skill-tags">
							<span class="skill-tag">Node.js</span>
							<span class="skill-tag">Express</span>
							<span class="skill-tag">RESTful APIs</span>
							<span class="skill-tag">GraphQL</span>
						</div>
					</div>

					<div class="skill-category">
						<h3>Database</h3>
						<div class="skill-tags">
							<span class="skill-tag">MongoDB</span>
							<span class="skill-tag">SQL</span>
							<span class="skill-tag">PostgreSQL</span>
							<span class="skill-tag">Firebase</span>
						</div>
					</div>

					<div class="skill-category">
						<h3>DevOps & Tools</h3>
						<div class="skill-tags">
							<span class="skill-tag">Git</span>
							<span class="skill-tag">AWS</span>
							<span class="skill-tag">Docker</span>
							<span class="skill-tag">CI/CD</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="projects">
			<h2 class="section-title">Projects</h2>
			<div class="projects-grid">
				<div class="project-card box">
					<h3>E-Commerce Platform</h3>
					<p>A full-featured online store with product management, shopping cart, and payment processing.</p>
					<div class="project-tags">
						<span class="project-tag">React</span>
						<span class="project-tag">Node.js</span>
						<span class="project-tag">MongoDB</span>
					</div>
					<a href="#" class="project-link">View Project</a>
				</div>

				<div class="project-card box">
					<h3>Task Management App</h3>
					<p>A collaborative task management application with real-time updates and team features.</p>
					<div class="project-tags">
						<span class="project-tag">TypeScript</span>
						<span class="project-tag">Express</span>
						<span class="project-tag">PostgreSQL</span>
					</div>
					<a href="#" class="project-link">View Project</a>
				</div>

				<div class="project-card box">
					<h3>Portfolio Website</h3>
					<p>A responsive portfolio website built with modern web technologies.</p>
					<div class="project-tags">
						<span class="project-tag">Astro</span>
						<span class="project-tag">Tailwind CSS</span>
						<span class="project-tag">JavaScript</span>
					</div>
					<a href="#" class="project-link">View Project</a>
				</div>
			</div>
		</section>

		<footer id="contact">
			<div class="footer-content">
				<h2 class="section-title">Get In Touch</h2>
				<p class="footer-text">Feel free to reach out for collaborations or just a friendly hello</p>

				<div class="social-links">
					<a href="https://linkedin.com/in/yourprofile" target="_blank" class="social-link" aria-label="LinkedIn Profile">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
							<rect x="2" y="9" width="4" height="12"></rect>
							<circle cx="4" cy="4" r="2"></circle>
						</svg>
						<span>LinkedIn</span>
					</a>

					<a href="https://github.com/yourprofile" target="_blank" class="social-link" aria-label="GitHub Profile">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
						</svg>
						<span>GitHub</span>
					</a>

					<a href="mailto:your.email@example.com" class="social-link" aria-label="Email">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
						<span>Email</span>
					</a>
				</div>
			</div>

			<div class="copyright">
				<p>&copy; {new Date().getFullYear()} Helder Lopez. All rights reserved.</p>
			</div>
		</footer>
	</main>
</div>

<style>
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
	}

	main {
		min-height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 20px;
		overflow-x: hidden;
		width: 100%;
	}

	#home {
		display: flex;
		align-items: center;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
		height: 100vh;
		width: 100%;
		max-width: 1200px;
		position: relative;
		text-align: center;
		scroll-margin-top: 80px;
	}

	h1 {
		font-size: 42px;
		margin-top: 0.25em;
		margin-bottom: 0.5em;
		font-weight: 700;
		background: linear-gradient(90deg, #3245ff 0%, #bc52ee 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	#links {
		display: flex;
		gap: 16px;
		justify-content: center;
		margin: 1rem auto;
	}

	#links a {
		display: flex;
		align-items: center;
		padding: 10px 12px;
		color: #111827;
		text-decoration: none;
		transition: color 0.2s;
	}

	#links a:hover {
		color: rgb(78, 80, 86);
	}

	#links a svg {
		height: 1em;
		margin-left: 8px;
	}

	#links a.button {
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border-radius: 10px;
	}

	#links a.button:hover {
		color: rgb(230, 230, 230);
		box-shadow: none;
	}

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
	}

	h2 {
		margin: 0 0 1em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		color: #4b5563;
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0;
	}

	code {
		display: inline-block;
		background:
			linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
			linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
		border-radius: 8px;
		border: 1px solid transparent;
		padding: 6px 8px;
	}

	.box {
		padding: 16px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid white;
	}

	.quote {
		margin: 2rem auto;
		max-width: 500px;
		backdrop-filter: blur(10px);
		background: rgba(255, 255, 255, 0.8);
	}

	.quote-text {
		font-style: italic;
		font-size: 18px;
		line-height: 1.5;
		color: #333;
	}

	.quote-author {
		margin-top: 8px;
		text-align: right;
		font-weight: 500;
	}

	#news {
		position: absolute;
		bottom: 16px;
		right: 16px;
		max-width: 300px;
		text-decoration: none;
		transition: background 0.2s;
		backdrop-filter: blur(50px);
	}

	#news:hover {
		background: rgba(255, 255, 255, 0.55);
	}

	@media screen and (max-height: 368px) {
		#news {
			display: none;
		}
	}

	/* Section styles */
	#about, #skills, #projects {
		width: 100%;
		max-width: 1200px;
		padding: 80px 16px;
		margin-top: 20px;
		scroll-margin-top: 80px;
	}

	.section-title {
		font-size: 32px;
		margin-bottom: 2rem;
		text-align: center;
		color: #111827;
		font-weight: 600;
	}

	.about-content, .skills-content {
		display: flex;
		gap: 40px;
		backdrop-filter: blur(10px);
		background: rgba(255, 255, 255, 0.8);
	}

	.about-text {
		flex: 3;
	}

	.about-text p {
		margin-bottom: 1rem;
		font-size: 17px;
		line-height: 1.6;
	}

	.skill-categories {
		display: flex;
		flex-wrap: wrap;
		gap: 30px;
		width: 100%;
	}

	.skill-category {
		flex: 1 1 calc(50% - 30px);
		min-width: 250px;
	}

	.skill-category h3 {
		font-size: 20px;
		margin-bottom: 1rem;
		color: #111827;
		position: relative;
		display: inline-block;
	}

	.skill-category h3:after {
		content: '';
		position: absolute;
		bottom: -5px;
		left: 0;
		width: 40px;
		height: 3px;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		border-radius: 3px;
	}

	/* Projects section styles */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 30px;
		width: 100%;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		backdrop-filter: blur(10px);
		background: rgba(255, 255, 255, 0.8);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		height: 100%;
	}

	.project-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
	}

	.project-card h3 {
		font-size: 20px;
		margin-bottom: 10px;
		color: #111827;
	}

	.project-card p {
		margin-bottom: 20px;
		flex-grow: 1;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 15px;
	}

	.project-tag {
		padding: 4px 10px;
		background: rgba(50, 69, 255, 0.1);
		color: #3245ff;
		border-radius: 20px;
		font-size: 12px;
		font-weight: 500;
	}

	.project-link {
		display: inline-block;
		padding: 8px 16px;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		color: white;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 500;
		align-self: flex-start;
		transition: opacity 0.2s ease;
	}

	.project-link:hover {
		opacity: 0.9;
	}

	/* Footer styles */
	#contact {
		width: 100%;
		max-width: 1200px;
		padding: 80px 16px 40px;
		margin-top: 40px;
		scroll-margin-top: 80px;
		text-align: center;
	}

	.footer-text {
		max-width: 600px;
		margin: 0 auto 40px;
		font-size: 18px;
		color: #4b5563;
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 30px;
		margin: 30px 0;
	}

	.social-link {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		color: #111827;
		text-decoration: none;
		transition: transform 0.3s ease, color 0.3s ease;
	}

	.social-link:hover {
		transform: translateY(-5px);
		color: #3245ff;
	}

	.social-link svg {
		width: 28px;
		height: 28px;
		transition: stroke 0.3s ease;
	}

	.social-link:hover svg {
		stroke: #3245ff;
	}

	.social-link span {
		font-size: 14px;
		font-weight: 500;
	}

	.copyright {
		margin-top: 60px;
		padding-top: 20px;
		border-top: 1px solid rgba(0, 0, 0, 0.1);
		font-size: 14px;
		color: #6b7280;
	}

	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.skill-tag {
		padding: 6px 12px;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		color: white;
		border-radius: 20px;
		font-size: 14px;
		font-weight: 500;
	}

	@media screen and (max-width: 768px) {
		#container {
			display: flex;
			flex-direction: column;
		}

		#home {
			display: block;
			padding-top: 10%;
			height: auto;
			min-height: 100vh;
		}

		#links {
			flex-wrap: wrap;
			margin: 2rem 0;
		}

		#links a.button {
			padding: 14px 18px;
		}

		#news {
			right: 16px;
			left: 16px;
			bottom: 2.5rem;
			max-width: 100%;
		}

		h1 {
			line-height: 1.5;
		}

		.about-content, .skills-content {
			flex-direction: column;
		}

		.about-text {
			flex: 1;
		}

		.skill-category {
			flex: 1 1 100%;
		}

		.social-links {
			flex-wrap: wrap;
			gap: 20px;
		}

		.social-link {
			width: 80px;
		}
	}
</style>
