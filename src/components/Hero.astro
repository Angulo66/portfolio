<section id="home">
  <!-- Mobile Theme Toggle Button (only visible on mobile) -->
  <button
    id="mobile-hero-theme-toggle"
    class="hidden md:hidden fixed top-4 right-4 z-50 p-2 rounded-full bg-white bg-opacity-80 backdrop-blur-sm transition-all duration-300 shadow-md hover:shadow-lg text-text-primary"
    aria-label="Toggle dark mode"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
  </button>

  <!-- Floating Elements -->
  <div class="floating-elements">
    <svg xmlns="http://www.w3.org/2000/svg" class="floating-piece floating-1" viewBox="0 0 50 40">
      <g fill="var(--floating-color-1)" stroke="currentColor" stroke-opacity="0.3" stroke-linejoin="round" stroke-width="1.23">
        <path d="M48.75 26.05c0 7.13-10.63 12.9-23.75 12.9S1.25 33.18 1.25 26.05v-9.66S15.16 17.96 25 17.96s23.75-1.57 23.75-1.57v9.66Z"
        ></path>
        <ellipse cx="25" cy="14.73" rx="23.75" ry="13.68"></ellipse>
      </g>
    </svg>

    <svg xmlns="http://www.w3.org/2000/svg" class="floating-piece floating-2" viewBox="0 0 50 40">
      <g fill="var(--floating-color-2)" stroke="currentColor" stroke-opacity="0.3" stroke-linejoin="round" stroke-width="1.23">
        <path d="M48.75 26.05c0 7.13-10.63 12.9-23.75 12.9S1.25 33.18 1.25 26.05v-9.66S15.16 17.96 25 17.96s23.75-1.57 23.75-1.57v9.66Z"
        ></path>
        <ellipse cx="25" cy="14.73" rx="23.75" ry="13.68"></ellipse>
      </g>
    </svg>

    <svg xmlns="http://www.w3.org/2000/svg" class="floating-piece floating-3" viewBox="0 0 50 40">
      <g fill="var(--floating-color-3)" stroke="currentColor" stroke-opacity="0.3" stroke-linejoin="round" stroke-width="1.23">
        <path d="M48.75 26.05c0 7.13-10.63 12.9-23.75 12.9S1.25 33.18 1.25 26.05v-9.66S15.16 17.96 25 17.96s23.75-1.57 23.75-1.57v9.66Z"
        ></path>
        <ellipse cx="25" cy="14.73" rx="23.75" ry="13.68"></ellipse>
      </g>
    </svg>

    <svg xmlns="http://www.w3.org/2000/svg" class="floating-piece floating-4" viewBox="0 0 50 40">
      <g fill="var(--floating-color-1)" stroke="currentColor" stroke-opacity="0.3" stroke-linejoin="round" stroke-width="1.23">
        <path d="M48.75 26.05c0 7.13-10.63 12.9-23.75 12.9S1.25 33.18 1.25 26.05v-9.66S15.16 17.96 25 17.96s23.75-1.57 23.75-1.57v9.66Z"
        ></path>
        <ellipse cx="25" cy="14.73" rx="23.75" ry="13.68"></ellipse>
      </g>
    </svg>

    <svg xmlns="http://www.w3.org/2000/svg" class="floating-piece floating-5" viewBox="0 0 50 40">
      <g fill="var(--floating-color-2)" stroke="currentColor" stroke-opacity="0.3" stroke-linejoin="round" stroke-width="1.23">
        <path d="M48.75 26.05c0 7.13-10.63 12.9-23.75 12.9S1.25 33.18 1.25 26.05v-9.66S15.16 17.96 25 17.96s23.75-1.57 23.75-1.57v9.66Z"
        ></path>
        <ellipse cx="25" cy="14.73" rx="23.75" ry="13.68"></ellipse>
