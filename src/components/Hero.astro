    <svg xmlns="http://www.w3.org/2000/svg" class="floating-piece floating-6" viewBox="0 0 50 40">
      <g fill="var(--floating-color-3)" stroke="currentColor" stroke-opacity="0.3" stroke-linejoin="round" stroke-width="1.23">
        <path d="M48.75 26.05c0 7.13-10.63 12.9-23.75 12.9S1.25 33.18 1.25 26.05v-9.66S15.16 17.96 25 17.96s23.75-1.57 23.75-1.57v9.66Z"
        ></path>
        <ellipse cx="25" cy="14.73" rx="23.75" ry="13.68"></ellipse>
      </g>
    </svg>
  </div>

  <h1>Helder Lopez</h1>
  <pre>Fullstack Developer</pre>
  <p>Passionate about crafting elegant solutions with modern web technologies</p>
</section>

<style>
  #home {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding: 16px;
    height: 100vh;
    width: 100%;
    max-width: 1200px;
    position: relative;
    text-align: center;
    scroll-margin-top: 80px;
    overflow: hidden;
  }

  /* Floating elements styles */
  .floating-elements {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
  }

  .floating-piece {
    position: absolute;
    opacity: 0.7;
    transition: opacity 0.3s ease, fill 0.3s ease;
  }

  .dark .floating-piece {
    opacity: 0.8;
  }

  .floating-1 {
    top: 15%;
    left: 10%;
    width: 60px;
    height: 60px;
    animation: float 8s ease-in-out infinite;
  }

  .floating-2 {
    top: 25%;
    right: 15%;
    width: 80px;
    height: 80px;
    animation: float 12s ease-in-out infinite 1s;
  }

  .floating-3 {
    bottom: 20%;
    left: 20%;
    width: 50px;
    height: 50px;
    animation: float 10s ease-in-out infinite 2s;
  }

  .floating-4 {
    top: 60%;
    right: 10%;
    width: 40px;
    height: 40px;
    animation: float 9s ease-in-out infinite 1.5s;
  }

  .floating-5 {
    top: 75%;
    right: 30%;
    width: 35px;
    height: 35px;
    animation: float 11s ease-in-out infinite 0.5s;
  }

  .floating-6 {
    top: 40%;
    left: 5%;
    width: 45px;
    height: 45px;
    animation: float 13s ease-in-out infinite 3s;
  }

  @keyframes float {
    0% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(10deg);
    }
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }

  /* Add a second animation for some elements */
  .floating-2,
  .floating-4,
  .floating-6 {
    animation-name: float-alt;
  }

  @keyframes float-alt {
    0% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
    33% {
      transform: translateY(-15px) rotate(5deg) scale(1.05);
    }
    66% {
      transform: translateY(10px) rotate(-5deg) scale(0.95);
    }
    100% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
  }

  h1 {
    font-size: 84px;
    margin-top: 0;
    margin-bottom: 0.2em;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  pre {
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    font-weight: normal;
    color: var(--text-secondary);
    margin: 0 0 1.5em 0;
    font-size: 24px;
    letter-spacing: 0.05em;
  }

  p {
    color: var(--text-secondary);
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.006em;
    margin: 0;
    max-width: 700px;
  }

  /* Mobile styles */
  @media screen and (max-width: 768px) {
    #home {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding-bottom: 0;
      height: 100vh;
      min-height: 100vh;
      margin-top: 0; /* Ensure no extra margin pushes content down */
      padding-top: 60px; /* Add padding to account for the fixed header */
    }

    h1 {
      font-size: 56px;
      margin-bottom: 0.2em;
      line-height: 1.1;
    }

    pre {
      font-size: 20px;
    }

    p {
      font-size: 18px;
    }
  }
</style>

<script>
  // Initialize mobile theme toggle button
  document.addEventListener('DOMContentLoaded', () => {
    const mobileThemeToggle = document.getElementById('mobile-hero-theme-toggle');

    // Show the toggle button only on mobile
    if (window.innerWidth <= 768) {
      mobileThemeToggle?.classList.remove('hidden');
    }

    // Update button icon based on current theme
    const updateMobileToggleIcon = () => {
      if (!mobileThemeToggle) return;

      const isDark = document.documentElement.classList.contains('dark');
      const sunIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>';
      const moonIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';

      mobileThemeToggle.innerHTML = isDark ? sunIcon : moonIcon;

      // Update background color based on theme
      if (isDark) {
        mobileThemeToggle.classList.add('bg-gray-800');
        mobileThemeToggle.classList.remove('bg-white');
      } else {
        mobileThemeToggle.classList.add('bg-white');
        mobileThemeToggle.classList.remove('bg-gray-800');
      }
    };

    // Initial icon update
    updateMobileToggleIcon();

    // Add click event listener
    mobileThemeToggle?.addEventListener('click', () => {
      // Use the global applyTheme function from Welcome.astro
      if (typeof window.applyTheme === 'function') {
        const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        window.applyTheme(newTheme);

        // Update the icon after theme change
        updateMobileToggleIcon();
      }
    });

    // Update visibility on window resize
    window.addEventListener('resize', () => {
      if (window.innerWidth <= 768) {
        mobileThemeToggle?.classList.remove('hidden');
      } else {
        mobileThemeToggle?.classList.add('hidden');
      }
    });

    // Listen for theme changes from other toggle buttons
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class') {
          updateMobileToggleIcon();
        }
      });
    });

    observer.observe(document.documentElement, { attributes: true });
  });
</script>
