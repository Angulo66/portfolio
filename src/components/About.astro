---

<section id="about">
  <h2 class="section-title">About Me</h2>
  <div class="about-content box">
    <div class="profile-container">
      <div class="profile-image-container">
        <div class="profile-image">
          <picture>
            <source srcset={meWebp.src} type="image/webp" />
            <img src={meFallback.src} alt="Helder Lopez" width="200" height="200" />
          </picture>
        </div>
      </div>
      <div class="about-text">
        <p>
          <strong>I am a Full-Stack Software Engineer</strong> passionate about building scalable web applications, optimizing system performance,
          and delivering high-quality, reliable code. Strong expertise in end-to-end development, and architecting robust backend systems. Focused
          on efficient problem-solving, clean architecture, and seamless user experiences—whether working with blockchain integrations, or high-traffic
          APIs.
        </p>
      </div>
    </div>

    <div class="skills-section">
      <h3 class="section-subtitle">Skills & Technologies</h3>
      <div class="skill-tags-container">
        {skills.map((skill) => <span class="project-tag">{skill}</span>)}
      </div>

      <!-- Marquee style skills with icons -->
      <div class="skills-marquee-container">
        <div class="skills-marquee">
          {
            technologies.map((technology) => (
              <div class="skill-icon-item">
                <div class="skill-icon" set:html={technology.icon} />
                <span class="skill-name">{technology.name}</span>
              </div>
            ))
          }
          {/* Duplicate for continuous scrolling effect */}
          {
            technologies.map((technology) => (
              <div class="skill-icon-item">
                <div class="skill-icon" set:html={technology.icon} />
                <span class="skill-name">{technology.name}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="experience-section">
      <h3 class="section-subtitle">Experience</h3>
      <div class="timeline">
        {
          workExperience.map((job) => (
            <div class="timeline-item">
              <div class="timeline-dot" />
              <div class="timeline-date">{job.period}</div>
              <div class="timeline-content">
                <h4>{job.title}</h4>
                <h5>{job.company}</h5>
                <p>{job.description}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- CV Download Button (visible only on mobile) -->
      <div class="cv-download-mobile">
        <a href="/resume.pdf" target="_blank" class="cv-button">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 mr-2"
            width="20"
            height="20"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Download CV
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .box {
    padding: 16px;
    background: var(--bg-secondary);
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }
  /* Section styles */
  #about,
  #skills,
  #projects {
    width: 100%;
    max-width: 1200px;
    padding: 80px 16px;
    margin-top: 20px;
    scroll-margin-top: 80px;
  }

  .section-title {
    font-size: 32px;
    margin-bottom: 2rem;
    text-align: center;
    color: var(--text-primary);
    font-weight: 600;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    backdrop-filter: blur(10px);
    background: var(--bg-secondary);
    padding: 30px;
  }

  .profile-container {
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }

  .profile-image-container {
    flex-shrink: 0;
  }

  .profile-image {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .dark .profile-image {
    box-shadow: 0 4px 10px rgba(255, 255, 255, 0.1);
  }

  .profile-image:hover {
    transform: scale(1.03);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
  }

  .dark .profile-image:hover {
    box-shadow: 0 6px 15px rgba(255, 255, 255, 0.15);
  }

  .profile-image img,
  .profile-image picture {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-text {
    flex: 1;
  }

  .about-text p {
    margin-bottom: 1rem;
    font-size: 17px;
    line-height: 1.6;
  }

  .skills-section {
    margin-top: 20px;
  }

  .section-subtitle {
    font-size: 24px;
    margin-bottom: 20px;
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Experience section styles */
  .skill-tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    justify-content: center;
    margin-top: 20px;
    margin-bottom: 30px;
  }

  .experience-section {
    margin-top: 30px;
    margin-bottom: 40px;
  }

  .timeline {
    position: relative;
    margin-left: 20px;
    padding-left: 20px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    height: calc(100% - 10px);
    width: 2px;
    background: var(--primary);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 30px;
  }

  .timeline-dot {
    position: absolute;
    left: -26px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--primary);
    border: 2px solid white;
  }

  .dark .timeline-dot {
    border-color: var(--bg-primary);
  }

  .timeline-date {
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 5px;
    font-size: 14px;
  }

  .timeline-content {
    padding-bottom: 10px;
  }

  .timeline-content h4 {
    font-size: 18px;
    margin-bottom: 5px;
    color: var(--text-primary);
    font-weight: 600;
  }

  .timeline-content h5 {
    font-size: 16px;
    margin-bottom: 10px;
    color: var(--text-secondary);
    font-weight: 500;
    font-style: italic;
  }

  .timeline-content p {
    font-size: 15px;
    line-height: 1.5;
  }

  .skill-tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    width: 100%;
    justify-content: left;
    margin-top: 20px;
  }

  /* Project tag styles for skills section */
  .project-tag {
    padding: 4px 10px;
    background: rgba(0, 0, 0, 0.05);
    color: var(--text-secondary);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  /* Skill tags now use project-tag styling */
  .skill-tags-container .project-tag {
    font-size: 12px;
    padding: 4px 10px;
    margin: 2px;
  }

  /* Marquee style skills section */
  .skills-marquee-container {
    width: 100%;
    overflow: hidden;
    margin-top: 30px;
    position: relative;
  }

  .skills-marquee {
    display: flex;
    animation: marquee 10s linear infinite;
    width: max-content;
  }

  .skill-icon-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin: 0 20px;
  }

  .skill-name {
    margin-left: 8px;
    font-weight: 500;
    font-size: 13px;
  }

  .skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--bg-primary);
    border-radius: 50%;
    padding: 7px;
    border: 1px solid var(--border-color);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .skill-icon:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  }

  .dark .skill-icon:hover {
    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.1);
  }

  .skill-icon svg {
    width: 100%;
    height: 100%;
    color: var(--primary);
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Pause animation on hover */
  .skills-marquee-container:hover .skills-marquee {
    animation-play-state: paused;
  }

  /* CV Download Button Styles */
  .cv-download-mobile {
    display: none; /* Hidden by default */
    margin-top: 30px;
    justify-content: center;
  }

  .cv-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--primary);
    color: var(--bg-primary);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .cv-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .profile-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }

    .profile-image {
      width: 180px;
      height: 180px;
    }

    .about-text {
      width: 100%;
    }

    .skill-icon-item {
      margin: 0 15px;
    }

    .skill-icon {
      width: 28px;
      height: 28px;
      padding: 5px;
    }

    .skill-name {
      font-size: 12px;
    }

    /* Show CV download button on mobile */
    .cv-download-mobile {
      display: flex;
    }
  }
</style>
