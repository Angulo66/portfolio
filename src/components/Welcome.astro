---
import background from '../assets/background.svg';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Footer from './Footer.astro';
import About from './About.astro';
---

<script>
  // Declare global types
  declare global {
    interface Window {
      updateActiveNavLink?: () => void;
      applyTheme?: (theme: 'light' | 'dark') => void;
    }
  }

  // Check for saved theme preference or use system preference
  const getInitialTheme = (): 'light' | 'dark' => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || savedTheme === 'dark') {
        return savedTheme;
      }
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  // Apply theme to document
  const applyTheme = (theme: 'light' | 'dark') => {
    document.documentElement.classList.remove('light', 'dark');
    document.documentElement.classList.add(theme);
    localStorage.setItem('theme', theme);

    // Update button icon
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      const sunIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>';
      const moonIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';
      themeToggle.innerHTML = theme === 'dark' ? sunIcon : moonIcon;
    }

    // Update nav indicators after theme change
    setTimeout(() => {
      if (typeof window.updateActiveNavLink === 'function') {
        window.updateActiveNavLink();
      }
    }, 50);
  };

  // Initialize theme on page load
  document.addEventListener('DOMContentLoaded', () => {
    const initialTheme = getInitialTheme();
    applyTheme(initialTheme);

    // Set up theme toggle button
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);
      });
    }

    // Make applyTheme function globally available
    window.applyTheme = applyTheme;
  });
</script>

<div id="container">
  <img id="background" src={background.src} alt="" fetchpriority="high" />
  <main>
    <Hero />

    <div class="section-separator">
      <div class="separator-line"></div>
    </div>

    <About/>

    <div class="section-separator">
      <div class="separator-line"></div>
    </div>

    <Projects />

    <div class="section-separator">
      <div class="separator-line"></div>
    </div>

    <Footer />
  </main>
</div>

<style>
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(100px) grayscale(100%);
    opacity: 0.5;
  }

  #container {
    font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
    height: 100%;
  }

  main {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 20px;
    overflow-x: hidden;
    width: 100%;
  }

  h2 {
    margin: 0 0 1em;
    font-weight: normal;
    color: var(--text-primary);
    font-size: 20px;
  }

  p {
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.006em;
    margin: 0;
  }

  code {
    display: inline-block;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 6px 8px;
  }

  .box {
    padding: 16px;
    background: var(--bg-secondary);
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }

  #news {
    position: absolute;
    bottom: 16px;
    right: 16px;
    max-width: 300px;
    text-decoration: none;
    transition: background 0.2s;
    backdrop-filter: blur(50px);
  }

  #news:hover {
    background: rgba(255, 255, 255, 0.55);
  }

  @media screen and (max-height: 368px) {
    #news {
      display: none;
    }
  }

  /* Section styles */
  #about,
  #skills,
  #projects {
    width: 100%;
    max-width: 1200px;
    padding: 80px 16px;
    margin-top: 20px;
    scroll-margin-top: 80px;
  }

  .section-title {
    font-size: 32px;
    margin-bottom: 2rem;
    text-align: center;
    color: var(--text-primary);
    font-weight: 600;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    backdrop-filter: blur(10px);
    background: var(--bg-secondary);
    padding: 30px;
  }

  .profile-container {
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }

  .profile-image-container {
    flex-shrink: 0;
  }

  .profile-image-placeholder {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px dashed rgba(0, 0, 0, 0.2);
    color: rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
  }

  .dark .profile-image-placeholder {
    background: rgba(255, 255, 255, 0.05);
    border: 2px dashed rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.5);
  }

  .profile-image-placeholder:hover {
    background: rgba(0, 0, 0, 0.1);
    cursor: pointer;
  }

  .dark .profile-image-placeholder:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .add-photo-text {
    font-size: 14px;
    margin-top: 12px;
  }

  .about-text {
    flex: 1;
  }

  .about-text p {
    margin-bottom: 1rem;
    font-size: 17px;
    line-height: 1.6;
  }

  .skills-section {
    margin-top: 20px;
  }

  .section-subtitle {
    font-size: 24px;
    margin-bottom: 20px;
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Experience section styles */
  .skill-tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    justify-content: center;
    margin-top: 20px;
    margin-bottom: 30px;
  }

  .experience-section {
    margin-top: 30px;
    margin-bottom: 40px;
  }

  .timeline {
    position: relative;
    margin-left: 20px;
    padding-left: 20px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    height: calc(100% - 10px);
    width: 2px;
    background: var(--primary);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 30px;
  }

  .timeline-dot {
    position: absolute;
    left: -26px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--primary);
    border: 2px solid white;
  }

  .dark .timeline-dot {
    border-color: var(--bg-primary);
  }

  .timeline-date {
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 5px;
    font-size: 14px;
  }

  .timeline-content {
    padding-bottom: 10px;
  }

  .timeline-content h4 {
    font-size: 18px;
    margin-bottom: 5px;
    color: var(--text-primary);
    font-weight: 600;
  }

  .timeline-content h5 {
    font-size: 16px;
    margin-bottom: 10px;
    color: var(--text-secondary);
    font-weight: 500;
    font-style: italic;
  }

  .timeline-content p {
    font-size: 15px;
    line-height: 1.5;
  }

  .cv-download {
    margin-top: 30px;
    display: flex;
    justify-content: center;
  }

  .cv-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--primary);
    color: var(--bg-primary);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .cv-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15);
  }

  .skill-tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    width: 100%;
    justify-content: left;
    margin-top: 20px;
  }

  /* Project tag styles for skills section */
  .project-tag {
    padding: 4px 10px;
    background: rgba(0, 0, 0, 0.05);
    color: var(--text-secondary);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  /* Skill tags now use project-tag styling */
  .skill-tags-container .project-tag {
    font-size: 14px;
    padding: 6px 12px;
    margin: 2px;
  }

  /* Section separator styles */
  .section-separator {
    width: 100%;
    max-width: 1200px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px 0;
    margin: 20px 0;
  }

  .separator-line {
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--primary) 50%, transparent 100%);
    opacity: 0.6;
    position: relative;
  }

  .separator-line::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--primary);
    box-shadow: 0 0 8px var(--primary);
  }

  @media screen and (max-width: 768px) {
    #container {
      display: flex;
      flex-direction: column;
    }

    /* Add padding to the bottom for mobile navbar */
    main {
      padding-bottom: 80px;
    }

    /* Hero mobile styles moved to Hero.astro component */

    #news {
      right: 16px;
      left: 16px;
      bottom: 2.5rem;
      max-width: 100%;
    }

    h1 {
      line-height: 1.5;
    }

    /* Profile container styles moved to About.astro component */

    .timeline {
      margin-left: 10px;
      padding-left: 15px;
    }

    .timeline-dot {
      left: -21px;
    }

    /* Mobile separator styles */
    .section-separator {
      padding: 10px 0;
      margin: 10px 0;
    }

    .separator-line {
      width: 90%;
    }
  }
</style>
