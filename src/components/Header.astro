---
// Header component for the portfolio site
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '';
---

<header class="fixed top-0 left-0 w-full z-50 transition-all duration-300 flex justify-center pt-8">
  <!-- Mobile Menu Button (only visible on mobile) -->
  <button
    id="mobile-menu-button"
    class="md:hidden fixed top-4 right-4 focus:outline-none backdrop-blur-sm p-2 rounded-full"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <!-- Centered Desktop Navigation -->
  <nav
    class="hidden md:block fixed top-8 backdrop-blur-sm rounded-full px-16 py-3 shadow-lg transition-all duration-300 animate-slide-down"
  >
    <div class="flex items-center gap-8">
      <button
        id="theme-toggle"
        class="transition-colors duration-300 p-1 rounded-full"
        aria-label="Toggle dark mode"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>

      <a href="#home" class="transition-colors duration-300 relative py-1 group" data-nav-link>
        Home
        <span
          class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full nav-indicator rounded-full shadow-glow"
        ></span>
      </a>

      <a
        href={isHomePage ? '#about' : '/'}
        class="transition-colors duration-300 relative py-1 group"
        data-nav-link
      >
        About
        <span
          class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full nav-indicator rounded-full shadow-glow"
        ></span>
      </a>



      <a href="#projects" class="transition-colors duration-300 relative py-1 group" data-nav-link>
        Projects
        <span
          class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full nav-indicator rounded-full shadow-glow"
        ></span>
      </a>

      <a href="#contact" class="transition-colors duration-300 relative py-1 group" data-nav-link>
        Contact
        <span
          class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full nav-indicator rounded-full shadow-glow"
        ></span>
      </a>

      <!-- CV/Resume Button with download icon -->
      <a
        href="/resume.pdf"
        target="_blank"
        class="transition-colors duration-300 relative py-1 group flex items-center"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path>
        </svg>
        CV
        <span
          class="absolute bottom-0 left-0 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-full rounded-full shadow-glow"
        ></span>
      </a>
    </div>
  </nav>

  <!-- Mobile Navigation Menu -->
  <div id="mobile-menu" class="hidden md:hidden fixed top-0 left-0 w-full h-full backdrop-blur-md z-50">
    <div class="absolute top-4 right-4">
      <button id="close-menu-button" class="focus:outline-none p-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="flex items-center justify-center h-full">
      <ul class="space-y-6 text-center">
        <li class="flex justify-center">
          <button
            id="mobile-theme-toggle"
            class="transition-colors duration-300 p-2 rounded-full"
            aria-label="Toggle dark mode"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </button>
        </li>
        <li>
          <a href="#home" class="block text-2xl transition-colors duration-300 py-2 relative group">
            Start
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-24 rounded-full shadow-glow nav-indicator"
            ></span>
          </a>
        </li>
        <li>
          <a
            href={isHomePage ? '#about' : '/'}
            class="block text-2xl transition-colors duration-300 py-2 relative group"
          >
            About
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-24 rounded-full shadow-glow nav-indicator"
            ></span>
          </a>
        </li>

        <li>
          <a
            href={isHomePage ? '#projects' : '/#projects'}
            class="block text-2xl transition-colors duration-300 py-2 relative group"
          >
            Projects
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-24 rounded-full shadow-glow nav-indicator"
            ></span>
          </a>
        </li>

        <li>
          <a
            href={isHomePage ? '#contact' : '/#contact'}
            class="block text-2xl transition-colors duration-300 py-2 relative group"
          >
            Contact
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-24 rounded-full shadow-glow nav-indicator"
            ></span>
          </a>
        </li>

        <!-- CV/Resume Link -->
        <li>
          <a
            href="/resume.pdf"
            target="_blank"
            class="text-2xl transition-colors duration-300 py-2 relative group flex items-center justify-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            Download CV
            <span
              class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-[2px] bg-primary transition-all duration-300 group-hover:w-24 rounded-full shadow-glow nav-indicator"
            ></span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  @keyframes slide-down {
    0% {
      transform: translateY(-20px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .animate-slide-down {
    animation: slide-down 0.5s ease forwards;
  }

  .shadow-glow {
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.3);
  }

  /* Indicator colors for light/dark mode */
  /* Light mode indicators */
  :root:not(.dark) .nav-indicator {
    background-color: var(--dark-indicator) !important;
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.3);
  }

  :root:not(.dark) a:hover .nav-indicator,
  :root:not(.dark) a:hover span.rounded-full {
    background-color: var(--dark-indicator) !important;
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.3);
  }

  /* Dark mode indicators */
  html.dark .nav-indicator {
    background-color: #ffffff !important;
    box-shadow: 0 0 3px rgba(255, 255, 255, 0.5);
  }

  html.dark a:hover .nav-indicator,
  html.dark a:hover span.rounded-full {
    background-color: #ffffff !important;
    box-shadow: 0 0 3px rgba(255, 255, 255, 0.5);
  }

  /* Ensure mobile menu indicators also follow the theme */
  html.dark #mobile-menu .nav-indicator {
    background-color: #ffffff !important;
    box-shadow: 0 0 3px rgba(255, 255, 255, 0.5);
  }

  html.dark #mobile-menu a:hover .nav-indicator {
    background-color: #ffffff !important;
    box-shadow: 0 0 3px rgba(255, 255, 255, 0.5);
  }
</style>

<script>
  // Mobile menu toggle functionality and scroll effects
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('nav.hidden.md\\:block');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const closeMenuButton = document.getElementById('close-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll('[data-nav-link]');
    const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

    // Mobile menu toggle
    if (mobileMenuButton && mobileMenu && closeMenuButton) {
      mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; // Prevent scrolling when menu is open
      });

      closeMenuButton.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        document.body.style.overflow = ''; // Re-enable scrolling
      });

      // Close menu when clicking on a link
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = ''; // Re-enable scrolling
        });
      });
    }

    // Sync mobile theme toggle with main theme toggle
    if (mobileThemeToggle) {
      mobileThemeToggle.addEventListener('click', () => {
        const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

        // Update theme
        document.documentElement.classList.remove('light', 'dark');
        document.documentElement.classList.add(newTheme);
        localStorage.setItem('theme', newTheme);

        // Update both toggle buttons
        const themeToggle = document.getElementById('theme-toggle');
        const sunIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>';
        const moonIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';

        if (themeToggle) {
          themeToggle.innerHTML = newTheme === 'dark' ? sunIcon : moonIcon;
        }

        const mobileSunIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>';
        const mobileMoonIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';

        mobileThemeToggle.innerHTML = newTheme === 'dark' ? mobileSunIcon : mobileMoonIcon;

        // Update nav indicators after theme change
        setTimeout(updateActiveNavLink, 50);
      });
    }

    // Update active nav link based on scroll position
    function updateActiveNavLink() {
      const scrollPosition = window.scrollY;
      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      const scrolledToBottom = scrollPosition + windowHeight >= documentHeight - 50; // Consider bottom when within 50px

      // Get all sections
      const sections = ['home', 'about', 'projects', 'contact']
        .map((id) => {
          const element = document.getElementById(id);
          return element ? {
            id,
            top: element.offsetTop - 100,
            bottom: element.offsetTop + element.offsetHeight,
            element
          } : null;
        })
        .filter((section) => section !== null) as { id: string; top: number; bottom: number; element: HTMLElement }[];

      // Find the current section
      let currentSection: string | null = null;

      // Find contact section for special handling
      const contactSection = sections.find(section => section.id === 'contact');

      // Special case for contact section when scrolled to bottom or near contact
      if (scrolledToBottom || (contactSection && scrollPosition >= contactSection.top - 100)) {
        currentSection = 'contact';
        // Contact section is active
      } else {
        // Normal section detection
        for (const section of sections) {
          if (scrollPosition >= section.top) {
            currentSection = section.id;
          } else {
            break;
          }
        }
      }

      // Update nav links
      if (currentSection) {

        navLinks.forEach((link) => {
          const href = link.getAttribute('href');
          const indicator = link.querySelector('.nav-indicator') as HTMLElement | null;

          // Improved handling for all sections including contact
          const isContactActive = currentSection === 'contact' && href && href.includes('#contact');
          const isOtherSectionActive = currentSection !== 'contact' && href && href.includes('#' + currentSection);



          if (isContactActive || isOtherSectionActive) {
            if (indicator) {
              indicator.style.width = '100%';
              // Ensure correct color based on theme
              if (document.documentElement.classList.contains('dark')) {
                indicator.style.backgroundColor = '#ffffff';
              } else {
                indicator.style.backgroundColor = 'var(--dark-indicator)';
              }
            }
          } else {
            if (indicator) indicator.style.width = '0';
          }
        });
      }
    }

    // Handle scroll events
    window.addEventListener('scroll', () => {
      // Add background to nav when scrolling
      if (window.scrollY > 50) {
        if (nav) nav.classList.add('shadow-xl');
      } else {
        if (nav) nav.classList.remove('shadow-xl');
      }

      // Update active nav link
      updateActiveNavLink();
    });

    // Initial check for active link
    updateActiveNavLink();

    // Update nav indicators when theme changes
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        // Small delay to ensure theme has changed before updating indicators
        setTimeout(updateActiveNavLink, 50);
      });
    }

    // Handle hash links smoothly
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
        const targetId = this.getAttribute('href') || '';
        if (targetId === '#') return;

        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({ behavior: 'smooth' });

          // Update URL without page reload
          history.pushState(null, '', targetId);

          // Update active nav link
          setTimeout(updateActiveNavLink, 100);
        }
      });
    });
  });
</script>
