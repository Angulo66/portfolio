---
// Project data
const projects = [
  {
    title: 'Monstermy.city',
    description: 'Customizable NFT Collection built on Ethereum, with a focus on customization and rarity.',
    technologies: ['Ethereum', 'React', 'Nextjs', 'Python', 'PostgreSQL', 'Ethers.js', 'Viem'],
    image: {
      placeholder: true,
      alt: 'Monstermy.city'
    }
  },
  {
    title: 'Socialbees.io',
    description:
      'Ethereum-based NFT collection built around a social community, creating a decentralized autonomous organization. and NFT Auctions',
    technologies: ['Web3', 'DeFi', 'React', 'Solidity', 'Web3.js', 'Hardhat'],
    image: {
      placeholder: true,
      alt: 'Socialbees.io'
    }
  },
  {
    title: 'Syklo.io',
    description: 'A non-custodial mobile wallet for stable coin transactions using secure peer-to-peer via smart contract-based escrow.',
    technologies: ['React Native', 'GraphQL', 'Node.js', 'Redux', 'Apollo Client'],
    image: {
      placeholder: true,
      alt: 'Syklo.io'
    }
  },
  {
    title: 'Swap Aggregator',
    description: 'A decentralized exchange aggregator for swapping tokens on Uniswap V2 and Balancer V2.',
    technologies: ['React', 'Solidity', 'The Graph', 'Neo4j', 'Go', 'gRPC'],
    image: {
      placeholder: true,
      alt: 'Swap Aggregator'
    }
  },
  {
    title: 'Backend Automation Service',
    description:
      "Automation ETL Service for a client's E-commerce driven with Shopify, Amazon Seller, Chargebee, and Quickbooks, to create Redash dashboards.",
    technologies: ['Node.js', 'PostgreSQL', 'Pm2', 'Redash', 'Redis'],
    image: {
      placeholder: true,
      alt: 'Backend Automation Service'
    }
  }
];
---

<section id="projects">
  <h2 class="section-title">Featured Projects</h2>
  <div class="projects-grid">
    {
      projects.map((project) => (
        <div class="project-card box">
          <div class="project-image-container">
            <div class="project-image-placeholder">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="40"
                height="40"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
              </svg>
              <span>{project.image.alt}</span>
            </div>
          </div>
          <div class="project-content">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="project-tags">
              {project.technologies.map((tech) => (
                <span class="project-tag">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Projects section styles */
  #projects {
    width: 100%;
    max-width: 1200px;
    padding: 80px 16px;
    margin-top: 20px;
    scroll-margin-top: 80px;
  }

  .section-title {
    font-size: 32px;
    margin-bottom: 2rem;
    text-align: center;
    color: var(--text-primary);
    font-weight: 600;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
    width: 100%;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(10px);
    background: var(--bg-secondary);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    height: 100%;
    overflow: hidden;
    border-radius: 16px;
    padding: 0;
    cursor: pointer;
  }

  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.08);
  }

  .project-image-container {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .project-image-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
  }

  .dark .project-image-placeholder {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.5);
  }

  .project-image-placeholder span {
    margin-top: 8px;
    font-size: 14px;
  }

  .project-content {
    padding: 20px;
  }

  .project-content h3 {
    font-size: 20px;
    margin-bottom: 10px;
    color: var(--text-primary);
  }

  .project-card p {
    margin-bottom: 0;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 15px;
  }

  .project-tag {
    padding: 4px 10px;
    background: rgba(0, 0, 0, 0.05);
    color: var(--text-secondary);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .box {
    padding: 16px;
    background: var(--bg-secondary);
    border-radius: 16px;
    border: 1px solid var(--border-color);
  }

  /* Add any missing styles that might be needed */
  p {
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.006em;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    #projects {
      padding: 60px 16px;
    }
  }
</style>
